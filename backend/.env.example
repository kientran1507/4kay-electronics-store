PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/4kay-store

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,https://your-vercel-domain.vercel.app

# AI assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# payOS online payment
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Shipping and vouchers
FREE_SHIPPING_MIN=20000000
SHIPPING_SAME_CITY_FEE=25000
SHIPPING_NEARBY_FEE=35000
SHIPPING_NATIONAL_FEE=50000
SHIPPING_REMOTE_FEE=70000

# Optional product imports
BESTBUY_API_KEY=
BESTBUY_IMPORT_KEYWORDS=laptop,phone,tablet,headphones
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
USD_TO_VND=25000
